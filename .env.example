# Copy to .env.local (gitignored) and fill in. Any OpenAI-compatible endpoint works.

# Local llama.cpp / LM Studio / Ollama (no key needed):
# LLM_BASE_URL=http://localhost:8080/v1        # llama.cpp server
# LLM_BASE_URL=http://localhost:1234/v1        # LM Studio
# LLM_BASE_URL=http://localhost:11434/v1       # Ollama
# LLM_MODEL=qwen3.8-flash-next-iq2_xs

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<vision-capable model id>
# LLM_API_KEY=sk-...

# Google Gemini (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<vision-capable model id>
# LLM_API_KEY=...

# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<vision-capable model id>
# LLM_API_KEY=sk-or-...
# LLM_EXTRA_HEADERS={"HTTP-Referer": "https://github.com/you/pdf2epub-ai", "X-Title": "pdf2epub-ai"}

# Provider-specific request fields (JSON). Faster reviews with reasoning models:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}   # llama.cpp / vLLM (Qwen)
# LLM_EXTRA_BODY={"reasoning_effort": "low"}                            # OpenAI / Gemini

# LLM_ENABLED=false            # default for --llm/--no-llm (CLI flag wins)
# PDF2EPUB_OUT_DIR=~/books     # default output directory (-o wins)

# Tuning
# LLM_CONCURRENCY=4            # parallel requests (match server slots / provider rate limits)
# LLM_MAX_IMAGES_PER_CALL=4
# LLM_JSON_MODE=auto           # auto | json_schema | json_object | prompt
# LLM_REVIEW_POLICY=flagged    # flagged | all | none
